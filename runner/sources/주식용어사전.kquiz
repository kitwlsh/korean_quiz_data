{
  "category": "주식 용어 사전",
  "creator": "개인 학습용",
  "creatorId": "personal",
  "version": 1,
  "questions": [
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "주식회사가 자본을 조달하기 위해 발행하며, 회사 소유권의 일부를 나타내는 증권은?", "answer": "주식", "explanation": "주식은 주식회사의 자본을 이루는 단위이자 회사 소유권(지분)을 나타내는 증권입니다.", "semanticHint": "회사의 '지분'을 쪼갠 것", "options": ["주식", "채권", "어음", "수표"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "주식을 보유하여 회사의 소유권 일부를 가진 사람을 무엇이라 하나요?", "answer": "주주", "explanation": "주주는 주식을 소유한 사람으로, 배당과 의결권 등의 권리를 가집니다.", "semanticHint": "주식의 주인", "options": ["주주", "채권자", "발행인", "수탁자"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "현재 주가에 총 발행 주식 수를 곱한 값으로, 기업의 시장 가치를 나타내는 지표는?", "answer": "시가총액", "explanation": "시가총액 = 주가 × 발행주식수. 기업의 시장에서의 총 가치를 의미합니다.", "semanticHint": "주가 곱하기 주식 수", "options": ["시가총액", "자본금", "매출액", "장부가치"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "주식 발행 시 정관에 정한 1주당 기준 금액으로, 실제 거래가격과는 다른 것은?", "answer": "액면가", "explanation": "액면가는 주권 표면에 적힌 1주당 명목 금액으로, 시장가격(시가)과 구분됩니다.", "semanticHint": "주권에 적힌 명목상의 값", "options": ["액면가", "시가", "종가", "공모가"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "의결권이 있으며 일반적으로 거래되는 표준적인 주식은?", "answer": "보통주", "explanation": "보통주는 의결권과 배당권을 가진 가장 일반적인 형태의 주식입니다.", "semanticHint": "의결권이 있는 일반 주식", "options": ["보통주", "우선주", "후배주", "상환주"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "의결권은 없지만 배당이나 잔여재산 분배에서 보통주보다 우선권을 갖는 주식은?", "answer": "우선주", "explanation": "우선주는 보통 의결권이 없는 대신 배당 등에서 우선적 지위를 갖습니다. 종목명 끝에 '우'가 붙는 경우가 많습니다.", "semanticHint": "배당을 먼저 받는 대신 투표권이 없는 주식", "options": ["우선주", "보통주", "성장주", "가치주"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "기업이 이익의 일부를 주주에게 나누어 주는 것을 무엇이라 하나요?", "answer": "배당", "explanation": "배당은 기업이 벌어들인 이익 중 일부를 주주에게 현금(현금배당)이나 주식(주식배당)으로 분배하는 것입니다.", "semanticHint": "이익을 주주에게 나눠줌", "options": ["배당", "증자", "감자", "상환"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "1주당 배당금을 현재 주가로 나눈 비율로, 투자금 대비 배당 수익을 나타내는 지표는?", "answer": "배당수익률", "explanation": "배당수익률 = 주당 배당금 ÷ 주가 × 100. 주가 대비 얼마의 배당을 받는지를 나타냅니다.", "semanticHint": "주가 대비 받는 배당의 비율", "options": ["배당수익률", "배당성향", "배당락", "표면금리"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "당기순이익 중 배당금으로 지급한 금액의 비율을 뜻하는 용어는?", "answer": "배당성향", "explanation": "배당성향 = 총배당금 ÷ 당기순이익 × 100. 이익 중 얼마를 배당으로 돌려주는지를 보여줍니다.", "semanticHint": "이익 중 배당에 쓴 비율", "options": ["배당성향", "배당수익률", "유보율", "부채비율"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "기업이 새로운 주식을 발행하여 주주나 투자자로부터 자금을 받아 자본금을 늘리는 것은?", "answer": "유상증자", "explanation": "유상증자는 신주를 발행해 돈을 받고 파는 것으로 실질적으로 자본이 늘어납니다.", "semanticHint": "돈을 받고 새 주식을 발행", "options": ["유상증자", "무상증자", "유상감자", "액면분할"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "잉여금을 자본금으로 전입하며 주주에게 대가 없이 새 주식을 나눠주는 것은?", "answer": "무상증자", "explanation": "무상증자는 회사의 잉여금을 자본금으로 옮기며 기존 주주에게 공짜로 주식을 배정하는 것입니다.", "semanticHint": "공짜로 주식을 더 주는 증자", "options": ["무상증자", "유상증자", "무상감자", "자사주소각"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "1주를 여러 주로 쪼개어 액면가를 낮추고 주식 수를 늘리는 것으로, 거래를 활발하게 하려는 목적이 있는 것은?", "answer": "액면분할", "explanation": "액면분할은 예를 들어 1주를 5주로 나누어 주당 가격을 낮추는 것으로, 기업가치 총액은 변하지 않습니다.", "semanticHint": "비싼 주식을 잘게 쪼갬", "options": ["액면분할", "액면병합", "유상증자", "감자"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "기업이 자기 회사의 주식을 시장에서 사들이는 행위로, 주가 안정이나 주주가치 제고 목적으로 하는 것은?", "answer": "자사주 매입", "explanation": "자사주 매입은 기업이 자기 주식을 되사는 것으로, 유통 주식 수를 줄여 주당 가치를 높이는 효과가 있습니다.", "semanticHint": "회사가 자기 주식을 되삼", "options": ["자사주 매입", "공모", "배당", "증자"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "비상장 기업이 증권시장에 처음으로 주식을 공개하고 상장하는 것을 뜻하는 용어(영문 약자)는?", "answer": "IPO", "explanation": "IPO(Initial Public Offering)는 기업공개로, 비상장사가 처음으로 대중에게 주식을 공모하고 상장하는 절차입니다.", "semanticHint": "기업공개, 첫 상장", "options": ["IPO", "M&A", "MOU", "ETF"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기본개념", "question": "공모주 청약에서 투자자가 주식을 배정받기 위해 정해진 1주당 가격을 뜻하는 말은?", "answer": "공모가", "explanation": "공모가는 IPO 시 일반 투자자에게 주식을 배정하는 가격으로, 수요예측을 통해 결정됩니다.", "semanticHint": "청약 때 사는 1주 가격", "options": ["공모가", "액면가", "시초가", "종가"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "장이 시작될 때 처음 형성된 가격을 무엇이라 하나요?", "answer": "시가", "explanation": "시가는 그날 거래가 시작되며 처음 체결된 가격입니다.", "semanticHint": "장 시작 첫 가격", "options": ["시가", "종가", "고가", "저가"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "그날 장이 마감될 때 마지막으로 형성된 가격은?", "answer": "종가", "explanation": "종가는 정규장 마감 시점에 결정된 최종 가격으로, 각종 지표 계산의 기준이 됩니다.", "semanticHint": "장 마감 마지막 가격", "options": ["종가", "시가", "고가", "기준가"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "하루 동안 주가가 오를 수 있는 최고 한도 가격을 뜻하는 용어는?", "answer": "상한가", "explanation": "상한가는 하루 가격제한폭의 상단(국내 주식 기준 전일 종가 대비 +30%)까지 오른 가격입니다.", "semanticHint": "하루 오를 수 있는 최고가", "options": ["상한가", "하한가", "고가", "천장"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "하루 동안 주가가 내릴 수 있는 최저 한도 가격은?", "answer": "하한가", "explanation": "하한가는 가격제한폭의 하단(국내 기준 전일 종가 대비 -30%)까지 내린 가격입니다.", "semanticHint": "하루 내릴 수 있는 최저가", "options": ["하한가", "상한가", "저가", "바닥"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "주식을 사거나 팔려고 제시하는 가격을 무엇이라 하나요?", "answer": "호가", "explanation": "호가는 매수/매도 주문에서 제시하는 가격으로, 매수호가와 매도호가가 만나 체결됩니다.", "semanticHint": "사자·팔자 부르는 값", "options": ["호가", "시가", "종가", "액면가"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "매수 주문과 매도 주문의 가격·수량이 맞아 거래가 성립되는 것을 뜻하는 용어는?", "answer": "체결", "explanation": "체결은 매수·매도 호가가 일치하여 실제 거래가 이루어지는 것입니다.", "semanticHint": "사자와 팔자가 만나 거래 성립", "options": ["체결", "청산", "예약", "정산"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "일정 기간(보통 하루) 동안 거래된 주식의 총 수량을 뜻하는 용어는?", "answer": "거래량", "explanation": "거래량은 특정 기간 동안 매매된 주식 수로, 시장의 관심과 유동성을 보여줍니다.", "semanticHint": "거래된 '주식 수'", "options": ["거래량", "거래대금", "유통량", "발행량"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "일정 기간 거래된 주식의 총 금액(주가 × 거래량 합)을 뜻하는 용어는?", "answer": "거래대금", "explanation": "거래대금은 거래된 주식의 금액 합계로, 거래량과 달리 '돈'의 규모를 나타냅니다.", "semanticHint": "거래된 '금액'", "options": ["거래대금", "거래량", "시가총액", "예수금"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "가격을 지정하지 않고 현재 시장에서 즉시 체결되도록 내는 주문은?", "answer": "시장가 주문", "explanation": "시장가 주문은 가격을 정하지 않고 현재 형성된 호가로 즉시 체결하는 주문 방식입니다.", "semanticHint": "값 안 정하고 바로 사는 주문", "options": ["시장가 주문", "지정가 주문", "조건부 주문", "예약 주문"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "원하는 가격을 정해두고 그 가격에 도달해야 체결되는 주문 방식은?", "answer": "지정가 주문", "explanation": "지정가 주문은 매매 희망 가격을 지정하여 그 가격 이하(매수)·이상(매도)에서만 체결되는 주문입니다.", "semanticHint": "가격을 정해 거는 주문", "options": ["지정가 주문", "시장가 주문", "손절 주문", "IOC 주문"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "장 시작 전이나 마감 시점에 일정 시간 주문을 모아 단일 가격으로 체결하는 방식은?", "answer": "동시호가", "explanation": "동시호가는 개장 전·마감 전 등 특정 시간에 접수된 주문을 모아 하나의 가격으로 체결하는 방식입니다.", "semanticHint": "주문을 모아 한 번에 체결", "options": ["동시호가", "접속매매", "시간외매매", "장중매매"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매/호가", "question": "매수 최우선 호가와 매도 최우선 호가의 가격 차이를 뜻하는 용어는?", "answer": "스프레드", "explanation": "스프레드(호가 스프레드)는 살 수 있는 최저가와 팔 수 있는 최고가 사이의 차이로, 좁을수록 유동성이 좋습니다.", "semanticHint": "사자-팔자 호가의 간격", "options": ["스프레드", "슬리피지", "괴리율", "변동성"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "거래제도", "question": "주가가 급락할 때 시장 전체의 매매를 일시 중단시키는 제도는?", "answer": "서킷브레이커", "explanation": "서킷브레이커(CB)는 지수가 일정 폭 이상 급락하면 시장 전체 거래를 일시 정지시키는 안정장치입니다.", "semanticHint": "시장 전체를 잠시 멈추는 '차단기'", "options": ["서킷브레이커", "사이드카", "VI", "단일가매매"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "거래제도", "question": "선물 가격이 급변할 때 프로그램 매매 호가를 일시적으로 제한(효력 정지)하는 제도는?", "answer": "사이드카", "explanation": "사이드카는 선물가격 급등락 시 프로그램 매매의 효력을 약 5분간 정지시켜 현물시장 충격을 완화하는 장치입니다.", "semanticHint": "프로그램 매매를 잠깐 멈추는 제도", "options": ["사이드카", "서킷브레이커", "VI", "공매도 금지"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "거래제도", "question": "개별 종목의 주가가 순간적으로 급변할 때 2~3분간 단일가매매로 전환시키는 변동성 완화장치는?", "answer": "VI", "explanation": "VI(Volatility Interruption)는 개별 종목의 급격한 가격 변동을 완화하기 위해 단일가매매로 잠시 전환하는 장치입니다.", "semanticHint": "개별 종목의 변동성 완화장치", "options": ["VI", "서킷브레이커", "사이드카", "LP"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "거래제도", "question": "주식을 빌려서 판 뒤 나중에 되사서 갚는 방식으로, 주가 하락에 베팅하는 투자 기법은?", "answer": "공매도", "explanation": "공매도는 없는 주식을 빌려 먼저 팔고 이후 싸게 되사서 갚아 차익을 얻는 매매로, 하락에 베팅합니다.", "semanticHint": "빌려서 먼저 팔고 나중에 갚음", "options": ["공매도", "신용매수", "물타기", "분할매수"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "거래제도", "question": "시장 전체가 아니라 특정 요건에서 접수된 주문을 모아 하나의 가격으로 체결하는 매매 방식은?", "answer": "단일가매매", "explanation": "단일가매매는 일정 시간 주문을 모아 하나의 균형가격으로 체결하는 방식으로, VI 발동 시 등에 쓰입니다.", "semanticHint": "여러 주문을 하나의 값으로", "options": ["단일가매매", "접속매매", "시간외 단일가", "블록딜"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "거래제도", "question": "컴퓨터 프로그램이 다수 종목을 미리 정한 조건에 따라 자동으로 대량 매매하는 것은?", "answer": "프로그램 매매", "explanation": "프로그램 매매는 지수 차익거래·비차익거래 등을 컴퓨터가 자동으로 일괄 처리하는 매매입니다.", "semanticHint": "컴퓨터가 자동으로 대량 매매", "options": ["프로그램 매매", "데이트레이딩", "스캘핑", "공매도"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "투자지표", "question": "주가를 주당순이익(EPS)으로 나눈 값으로, 이익 대비 주가 수준을 보는 대표 지표는?", "answer": "PER", "explanation": "PER(주가수익비율) = 주가 ÷ EPS. 값이 낮을수록 이익 대비 저평가로 해석되는 경향이 있습니다.", "semanticHint": "주가가 이익의 몇 배인가", "options": ["PER", "PBR", "ROE", "EPS"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "투자지표", "question": "주가를 주당순자산(BPS)으로 나눈 값으로, 자산가치 대비 주가 수준을 보는 지표는?", "answer": "PBR", "explanation": "PBR(주가순자산비율) = 주가 ÷ BPS. 1배 미만이면 청산가치보다 주가가 낮다는 의미로 해석되기도 합니다.", "semanticHint": "주가가 순자산의 몇 배인가", "options": ["PBR", "PER", "PSR", "ROA"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "투자지표", "question": "당기순이익을 발행주식 수로 나눈 값으로, 1주가 벌어들인 이익을 뜻하는 지표는?", "answer": "EPS", "explanation": "EPS(주당순이익) = 당기순이익 ÷ 주식수. 1주당 이익 창출력을 나타냅니다.", "semanticHint": "1주가 번 순이익", "options": ["EPS", "BPS", "DPS", "ROE"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "투자지표", "question": "자기자본을 발행주식 수로 나눈 값으로, 1주당 순자산을 뜻하는 지표는?", "answer": "BPS", "explanation": "BPS(주당순자산) = 자기자본 ÷ 주식수. 1주가 가진 장부상 자산가치를 나타냅니다.", "semanticHint": "1주당 순자산", "options": ["BPS", "EPS", "PBR", "NAV"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "투자지표", "question": "당기순이익을 자기자본으로 나눈 값으로, 주주 자본의 수익성을 보는 지표는?", "answer": "ROE", "explanation": "ROE(자기자본이익률) = 당기순이익 ÷ 자기자본 × 100. 주주 돈으로 얼마나 이익을 냈는지를 봅니다.", "semanticHint": "자기자본으로 낸 이익률", "options": ["ROE", "ROA", "PER", "EPS"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "투자지표", "question": "당기순이익을 총자산으로 나눈 값으로, 자산 전체의 수익성을 보는 지표는?", "answer": "ROA", "explanation": "ROA(총자산이익률) = 당기순이익 ÷ 총자산 × 100. 보유 자산을 얼마나 효율적으로 굴렸는지를 봅니다.", "semanticHint": "총자산으로 낸 이익률", "options": ["ROA", "ROE", "ROI", "PBR"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "투자지표", "question": "기업가치(EV)를 세전영업이익(EBITDA)으로 나눈 값으로, 기업 인수가치를 보는 지표는?", "answer": "EV/EBITDA", "explanation": "EV/EBITDA는 기업가치가 영업현금창출력의 몇 배인지를 보여주며, 기업 간 비교나 M&A 평가에 쓰입니다.", "semanticHint": "기업가치가 영업이익(감가상각 전)의 몇 배", "options": ["EV/EBITDA", "PER", "PSR", "PEG"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "투자지표", "question": "주가를 주당매출액으로 나눈 값으로, 매출 대비 주가 수준을 보는 지표는?", "answer": "PSR", "explanation": "PSR(주가매출비율) = 주가 ÷ 주당매출액. 아직 이익이 적은 성장기업 평가에 활용됩니다.", "semanticHint": "주가가 매출의 몇 배", "options": ["PSR", "PER", "PBR", "PCR"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "투자지표", "question": "PER를 이익성장률로 나눈 값으로, 성장성을 감안한 밸류에이션 지표는?", "answer": "PEG", "explanation": "PEG = PER ÷ 이익성장률(%). 1보다 낮으면 성장 대비 저평가로 보는 경향이 있습니다.", "semanticHint": "성장성으로 보정한 PER", "options": ["PEG", "PSR", "EV/EBITDA", "ROE"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "종가가 시가보다 높아 캔들 몸통을 보통 붉은색(또는 흰색)으로 표시하는 상승 캔들은?", "answer": "양봉", "explanation": "양봉은 종가가 시가보다 높은 상승 캔들로, 한국에서는 보통 빨간색으로 표시합니다.", "semanticHint": "종가가 시가보다 높은 캔들", "options": ["양봉", "음봉", "도지", "십자선"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "종가가 시가보다 낮아 몸통을 보통 파란색(또는 검은색)으로 표시하는 하락 캔들은?", "answer": "음봉", "explanation": "음봉은 종가가 시가보다 낮은 하락 캔들로, 한국에서는 보통 파란색으로 표시합니다.", "semanticHint": "종가가 시가보다 낮은 캔들", "options": ["음봉", "양봉", "망치형", "장대양봉"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "일정 기간의 주가 평균을 선으로 이어 추세를 파악하는 지표는?", "answer": "이동평균선", "explanation": "이동평균선은 5일·20일·60일 등 일정 기간 종가 평균을 이은 선으로, 추세 판단에 쓰입니다.", "semanticHint": "주가 평균을 이은 선", "options": ["이동평균선", "볼린저밴드", "추세선", "일목균형표"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "단기 이동평균선이 장기 이동평균선을 아래에서 위로 뚫고 올라가는 매수 신호를 뜻하는 용어는?", "answer": "골든크로스", "explanation": "골든크로스는 단기선이 장기선을 상향 돌파하는 것으로, 상승 추세 전환의 신호로 해석됩니다.", "semanticHint": "단기선이 장기선을 위로 돌파", "options": ["골든크로스", "데드크로스", "갭상승", "이격도"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "단기 이동평균선이 장기 이동평균선을 위에서 아래로 뚫고 내려가는 매도 신호는?", "answer": "데드크로스", "explanation": "데드크로스는 단기선이 장기선을 하향 돌파하는 것으로, 하락 추세 전환의 신호로 해석됩니다.", "semanticHint": "단기선이 장기선을 아래로 돌파", "options": ["데드크로스", "골든크로스", "갭하락", "역배열"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "주가가 하락하다가 잘 내려가지 않고 받쳐주는 가격대를 뜻하는 용어는?", "answer": "지지선", "explanation": "지지선은 매수세가 유입되어 주가 하락을 멈추게 하는 가격대입니다.", "semanticHint": "더 안 떨어지게 받쳐주는 선", "options": ["지지선", "저항선", "추세선", "돌파선"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "주가가 상승하다가 잘 오르지 못하고 눌리는 가격대를 뜻하는 용어는?", "answer": "저항선", "explanation": "저항선은 매도세가 강해 주가 상승을 막는 가격대입니다.", "semanticHint": "더 못 오르게 누르는 선", "options": ["저항선", "지지선", "이평선", "채널선"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "0~100 사이 값으로 과매수·과매도를 판단하는 대표적 보조지표는?", "answer": "RSI", "explanation": "RSI(상대강도지수)는 보통 70 이상이면 과매수, 30 이하면 과매도로 해석하는 모멘텀 지표입니다.", "semanticHint": "과매수·과매도를 보는 지수(0~100)", "options": ["RSI", "MACD", "볼린저밴드", "OBV"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "단기·장기 지수이동평균의 차이와 시그널선으로 추세와 모멘텀을 보는 지표는?", "answer": "MACD", "explanation": "MACD는 두 지수이동평균(EMA)의 차이를 이용해 추세 전환과 모멘텀을 파악하는 지표입니다.", "semanticHint": "두 이평선 차이로 보는 추세 지표", "options": ["MACD", "RSI", "스토캐스틱", "CCI"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "이동평균선을 중심으로 표준편차 밴드를 그려 변동성과 가격 범위를 보는 지표는?", "answer": "볼린저밴드", "explanation": "볼린저밴드는 중심선(이평선)과 상·하한 밴드로 구성되어 변동성 확대·수축과 가격 위치를 판단합니다.", "semanticHint": "표준편차로 만든 상·하 밴드", "options": ["볼린저밴드", "일목균형표", "엔벨로프", "RSI"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "주가의 고점들 또는 저점들을 직선으로 이어 방향성을 파악하는 선은?", "answer": "추세선", "explanation": "추세선은 저점 또는 고점을 이어 상승·하락·횡보 추세를 시각적으로 보여줍니다.", "semanticHint": "고점끼리·저점끼리 이은 선", "options": ["추세선", "지지선", "이동평균선", "채널"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "기술적분석", "question": "전일 종가와 당일 시가 사이에 거래 없이 벌어진 가격 공백을 뜻하는 용어는?", "answer": "갭", "explanation": "갭(Gap)은 캔들 사이에 거래가 없어 생긴 빈 공간으로, 갭상승·갭하락으로 나타납니다.", "semanticHint": "캔들 사이 빈 공백", "options": ["갭", "꼬리", "몸통", "밴드"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장/지수", "question": "한국거래소 유가증권시장의 대표 종합주가지수는?", "answer": "코스피", "explanation": "코스피(KOSPI)는 유가증권시장 상장 종목 전체의 시가총액을 기준으로 산출하는 대표 지수입니다.", "semanticHint": "한국 유가증권시장 대표 지수", "options": ["코스피", "코스닥", "코넥스", "나스닥"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장/지수", "question": "기술·벤처 기업 중심으로 상장되는 한국의 시장 및 그 지수는?", "answer": "코스닥", "explanation": "코스닥(KOSDAQ)은 중소·벤처·기술기업 중심의 시장으로, 미국 나스닥을 벤치마킹해 만들어졌습니다.", "semanticHint": "한국의 벤처·기술주 시장", "options": ["코스닥", "코스피", "코넥스", "S&P500"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장/지수", "question": "코스닥 상장 전 초기 중소·벤처기업을 위해 만든 한국의 시장은?", "answer": "코넥스", "explanation": "코넥스(KONEX)는 초기 중소·벤처기업의 자금조달을 돕기 위한 시장으로, 코스닥의 전 단계 성격입니다.", "semanticHint": "초기 벤처를 위한 시장", "options": ["코넥스", "코스닥", "코스피", "K-OTC"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장/지수", "question": "애플·마이크로소프트 등 기술주가 많이 상장된 미국의 대표 기술주 중심 시장은?", "answer": "나스닥", "explanation": "나스닥(NASDAQ)은 미국의 대표적 기술·성장주 중심 전자거래 시장입니다.", "semanticHint": "미국 기술주 중심 시장", "options": ["나스닥", "코스닥", "다우존스", "항셍"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장/지수", "question": "미국 대형주 500개로 구성된 대표적 시장지수는?", "answer": "S&P500", "explanation": "S&P500은 미국 대형 상장기업 500개로 구성된 시가총액 가중 지수로, 미국 시장 대표 지표입니다.", "semanticHint": "미국 대형주 500개 지수", "options": ["S&P500", "다우존스", "나스닥100", "러셀2000"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장/지수", "question": "미국의 대표 우량주 30개로 구성된 가격가중 방식의 지수는?", "answer": "다우존스 지수", "explanation": "다우존스산업평균지수(DJIA)는 미국 대표 우량기업 30개로 구성된 가격가중 지수입니다.", "semanticHint": "미국 우량주 30개 지수", "options": ["다우존스 지수", "S&P500", "나스닥종합", "코스피200"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장/지수", "question": "S&P500 옵션의 변동성을 나타내며 '공포지수'라고도 불리는 지표는?", "answer": "VIX", "explanation": "VIX는 S&P500 옵션의 내재변동성을 지수화한 것으로, 값이 높을수록 시장 불안이 큼을 뜻해 공포지수로 불립니다.", "semanticHint": "시장 공포를 나타내는 변동성 지수", "options": ["VIX", "VI", "PMI", "CPI"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "미래 특정 시점에 정해진 가격으로 기초자산을 사고팔기로 약속하는 파생상품은?", "answer": "선물", "explanation": "선물(Futures)은 미래의 정해진 날짜에 미리 약정한 가격으로 거래하기로 한 표준화된 계약입니다.", "semanticHint": "미래에 정한 값으로 거래하는 약속", "options": ["선물", "옵션", "스왑", "워런트"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "미래에 정해진 가격으로 기초자산을 '살 수 있는 권리'를 뜻하는 옵션은?", "answer": "콜옵션", "explanation": "콜옵션은 정해진 가격(행사가)에 기초자산을 매수할 수 있는 권리로, 가격 상승 시 이익을 봅니다.", "semanticHint": "살 수 있는 권리", "options": ["콜옵션", "풋옵션", "선물", "스왑"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "미래에 정해진 가격으로 기초자산을 '팔 수 있는 권리'를 뜻하는 옵션은?", "answer": "풋옵션", "explanation": "풋옵션은 정해진 가격에 기초자산을 매도할 수 있는 권리로, 가격 하락 시 이익을 봅니다.", "semanticHint": "팔 수 있는 권리", "options": ["풋옵션", "콜옵션", "선물", "전환사채"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "증권사에서 돈을 빌려 주식을 매수하고 이자를 내는 거래 방식은?", "answer": "신용거래", "explanation": "신용거래(신용매수)는 증거금을 담보로 증권사 자금을 빌려 주식을 사는 것으로, 레버리지 효과와 이자 부담이 있습니다.", "semanticHint": "돈을 빌려 주식을 사는 거래", "options": ["신용거래", "현금거래", "공매도", "대차거래"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "결제일까지 돈을 완납하지 못해 발생한, 증권사에 갚아야 할 외상 금액은?", "answer": "미수금", "explanation": "미수금은 매수 대금을 결제일까지 채우지 못해 생긴 외상으로, 미납 시 반대매매가 발생합니다.", "semanticHint": "결제 못한 외상 금액", "options": ["미수금", "예수금", "증거금", "잔고"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "신용·미수 거래에서 담보가 부족해지면 증권사가 투자자 동의 없이 강제로 주식을 파는 것은?", "answer": "반대매매", "explanation": "반대매매는 담보비율 미달·미수 미상환 시 증권사가 보유 주식을 강제 매도해 채권을 회수하는 것입니다.", "semanticHint": "증권사의 강제 매도", "options": ["반대매매", "손절매", "물타기", "청산배당"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "신용거래나 파생거래 시 담보로 예치해야 하는 최소 금액을 뜻하는 용어는?", "answer": "증거금", "explanation": "증거금은 신용·파생 거래에서 거래 이행을 보증하기 위해 예치하는 담보 성격의 금액입니다.", "semanticHint": "거래를 위해 맡기는 담보금", "options": ["증거금", "예수금", "미수금", "수수료"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "적은 자기자본으로 큰 규모의 투자 효과를 내는 '지렛대 효과'를 뜻하는 용어는?", "answer": "레버리지", "explanation": "레버리지는 빚 등을 활용해 투자 규모를 키워 수익률을 확대하는 것으로, 손실도 함께 커집니다.", "semanticHint": "지렛대 효과", "options": ["레버리지", "헤지", "차익거래", "분산투자"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "보유 자산의 가격 변동 위험을 줄이기 위해 반대 포지션을 취하는 위험 회피 전략은?", "answer": "헤지", "explanation": "헤지(Hedge)는 선물·옵션 등으로 반대 포지션을 잡아 가격 변동 위험을 상쇄·완화하는 전략입니다.", "semanticHint": "위험을 상쇄하는 방어 전략", "options": ["헤지", "레버리지", "스캘핑", "물타기"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "파생/신용", "question": "주식을 보유한 기관 등에서 주식을 빌리고 빌려주는 거래로, 공매도의 바탕이 되는 것은?", "answer": "대차거래", "explanation": "대차거래는 주식을 빌리고 빌려주는 거래로, 공매도에 필요한 주식을 조달하는 수단이 됩니다.", "semanticHint": "주식을 빌리고 빌려주는 거래", "options": ["대차거래", "대주거래", "차익거래", "블록딜"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "재무", "question": "기업이 상품·서비스를 팔아 벌어들인 총수입을 뜻하는 재무 항목은?", "answer": "매출액", "explanation": "매출액은 기업이 영업활동으로 벌어들인 총수입(총매출)으로, 손익계산서의 맨 위 항목입니다.", "semanticHint": "팔아서 번 총수입", "options": ["매출액", "영업이익", "당기순이익", "자본금"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "재무", "question": "매출액에서 매출원가와 판매관리비를 뺀, 본업에서 번 이익은?", "answer": "영업이익", "explanation": "영업이익 = 매출액 - 매출원가 - 판매비와관리비. 기업 본연의 영업 활동으로 벌어들인 이익입니다.", "semanticHint": "본업으로 번 이익", "options": ["영업이익", "매출총이익", "당기순이익", "경상이익"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "재무", "question": "영업외손익과 세금까지 모두 반영한 뒤 최종적으로 남은 이익은?", "answer": "당기순이익", "explanation": "당기순이익은 영업이익에 영업외손익을 반영하고 법인세를 뺀 최종 이익으로, EPS 계산의 기준입니다.", "semanticHint": "세금까지 뗀 최종 이익", "options": ["당기순이익", "영업이익", "매출총이익", "세전이익"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "재무", "question": "부채를 자기자본으로 나눈 비율로, 재무 안정성을 보는 대표 지표는?", "answer": "부채비율", "explanation": "부채비율 = 부채 ÷ 자기자본 × 100. 낮을수록 재무구조가 안정적인 것으로 봅니다.", "semanticHint": "빚이 자기자본의 몇 %인가", "options": ["부채비율", "유동비율", "자기자본비율", "이자보상배율"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "재무", "question": "유동자산을 유동부채로 나눈 값으로, 단기 지급능력을 보는 지표는?", "answer": "유동비율", "explanation": "유동비율 = 유동자산 ÷ 유동부채 × 100. 200% 이상이면 단기 지급능력이 양호한 편으로 봅니다.", "semanticHint": "단기 빚 갚을 능력", "options": ["유동비율", "부채비율", "당좌비율", "회전율"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "재무", "question": "총자산에서 부채를 뺀, 주주 몫에 해당하는 순수 자기 재산을 뜻하는 것은?", "answer": "자기자본", "explanation": "자기자본 = 총자산 - 부채. 주주에게 귀속되는 순자산으로 자본총계라고도 합니다.", "semanticHint": "자산에서 빚을 뺀 주주의 몫", "options": ["자기자본", "자본금", "부채", "잉여금"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "재무", "question": "영업이익을 매출액으로 나눈 값으로, 매출 대비 수익성을 보는 지표는?", "answer": "영업이익률", "explanation": "영업이익률 = 영업이익 ÷ 매출액 × 100. 매출 100원당 영업이익을 얼마 냈는지를 봅니다.", "semanticHint": "매출 대비 영업이익 비율", "options": ["영업이익률", "순이익률", "매출총이익률", "ROE"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "재무", "question": "일정 기간 기업의 현금 유입과 유출을 영업·투자·재무 활동으로 나누어 보여주는 재무제표는?", "answer": "현금흐름표", "explanation": "현금흐름표는 영업·투자·재무활동별 현금의 들어오고 나감을 보여주어 실제 현금창출력을 파악하게 합니다.", "semanticHint": "현금의 들고 남을 보는 표", "options": ["현금흐름표", "손익계산서", "재무상태표", "자본변동표"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "채권/금리", "question": "정부나 기업이 자금을 빌리면서 발행하는, 원금과 이자를 갚기로 한 채무 증서는?", "answer": "채권", "explanation": "채권은 발행자가 일정 이자를 지급하고 만기에 원금을 상환하기로 약속한 채무증권입니다.", "semanticHint": "돈을 빌리며 발행하는 차용증", "options": ["채권", "주식", "어음", "선물"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "채권/금리", "question": "국가(정부)가 재정 자금을 조달하기 위해 발행하는 채권은?", "answer": "국채", "explanation": "국채는 정부가 발행하는 채권으로, 신용도가 높아 안전자산으로 분류됩니다.", "semanticHint": "정부가 발행하는 채권", "options": ["국채", "회사채", "지방채", "특수채"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "채권/금리", "question": "기업이 자금 조달을 위해 발행하는 채권으로, 국채보다 금리가 높은 편인 것은?", "answer": "회사채", "explanation": "회사채는 기업이 발행하는 채권으로, 신용위험이 있어 국채보다 금리(수익률)가 높은 경향이 있습니다.", "semanticHint": "기업이 발행하는 채권", "options": ["회사채", "국채", "통안채", "지방채"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "채권/금리", "question": "채권 액면에 표시되어 정기적으로 지급되는 이자율을 뜻하는 용어는?", "answer": "표면금리", "explanation": "표면금리(쿠폰금리)는 채권 액면가 대비 지급되는 명목 이자율입니다.", "semanticHint": "채권에 적힌 이자율", "options": ["표면금리", "만기수익률", "실효금리", "기준금리"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "채권/금리", "question": "채권을 현재 가격에 사서 만기까지 보유할 때 얻는 연평균 수익률을 뜻하는 용어는?", "answer": "만기수익률", "explanation": "만기수익률(YTM)은 현재 채권 가격, 표면이자, 만기 상환액을 모두 반영한 실질 수익률입니다.", "semanticHint": "만기까지 보유 시 실제 수익률", "options": ["만기수익률", "표면금리", "배당수익률", "할인율"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "채권/금리", "question": "한 나라의 중앙은행이 통화정책을 위해 정하는, 시중금리의 기준이 되는 금리는?", "answer": "기준금리", "explanation": "기준금리는 중앙은행(한국은 한국은행)이 정하는 정책금리로, 시장금리 전반에 영향을 줍니다.", "semanticHint": "중앙은행이 정하는 정책금리", "options": ["기준금리", "표면금리", "가산금리", "우대금리"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "채권/금리", "question": "채권 발행자의 원리금 상환 능력을 평가해 AAA, BBB 등으로 매긴 등급은?", "answer": "신용등급", "explanation": "신용등급은 신용평가사가 발행자의 부도 위험을 평가해 표시한 등급으로, 낮을수록 금리가 높아집니다.", "semanticHint": "부도 위험을 매긴 등급(AAA 등)", "options": ["신용등급", "투자등급", "배당등급", "우선순위"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "펀드/ETF", "question": "여러 투자자의 자금을 모아 전문가가 대신 운용하는 간접투자 상품은?", "answer": "펀드", "explanation": "펀드는 다수 투자자의 자금을 모아 자산운용사가 주식·채권 등에 분산투자하는 상품입니다.", "semanticHint": "돈을 모아 전문가가 굴리는 상품", "options": ["펀드", "예금", "채권", "선물"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "펀드/ETF", "question": "특정 지수를 추종하며 주식처럼 실시간으로 거래소에서 사고팔 수 있는 상장 펀드는?", "answer": "ETF", "explanation": "ETF(상장지수펀드)는 지수를 추종하는 펀드를 주식처럼 거래소에 상장해 실시간 매매할 수 있게 한 상품입니다.", "semanticHint": "주식처럼 거래되는 지수 펀드", "options": ["ETF", "ETN", "펀드", "리츠"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "펀드/ETF", "question": "증권사가 발행하며 기초지수 수익을 지급하기로 약속한 상장 채무증권은?", "answer": "ETN", "explanation": "ETN(상장지수증권)은 증권사가 발행하는 파생결합증권으로, ETF와 비슷하나 발행사 신용위험이 있습니다.", "semanticHint": "증권사가 발행하는 지수 연동 증권", "options": ["ETN", "ETF", "펀드", "채권"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "펀드/ETF", "question": "특정 지수를 그대로 따라가는 것을 목표로 운용하는 소극적(패시브) 펀드는?", "answer": "인덱스펀드", "explanation": "인덱스펀드는 코스피200 같은 지수를 그대로 추종하는 것을 목표로 하며 운용보수가 낮은 편입니다.", "semanticHint": "지수를 그대로 따라가는 펀드", "options": ["인덱스펀드", "액티브펀드", "헤지펀드", "사모펀드"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "펀드/ETF", "question": "펀드·ETF가 보유한 자산의 순가치를 좌수(주)로 나눈 1좌당 가치를 뜻하는 용어는?", "answer": "NAV", "explanation": "NAV(순자산가치)는 펀드 총자산에서 부채를 뺀 순자산을 발행 좌수로 나눈 1좌당 기준가치입니다.", "semanticHint": "펀드의 1좌당 순자산가치", "options": ["NAV", "BPS", "PBR", "EPS"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "펀드/ETF", "question": "투자자 자금을 모아 부동산이나 부동산 관련 자산에 투자해 임대·매각 수익을 배당하는 상품은?", "answer": "리츠", "explanation": "리츠(REITs)는 부동산투자회사로, 부동산에서 나오는 임대·매각 수익을 투자자에게 배당하며 증시에 상장되기도 합니다.", "semanticHint": "부동산에 투자하는 상장 상품", "options": ["리츠", "ETF", "인덱스펀드", "MMF"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "주가가 전반적으로 상승하는 낙관적인 시장 상황을 뜻하는 용어는?", "answer": "강세장", "explanation": "강세장(불마켓, Bull Market)은 주가가 지속적으로 오르는 낙관적 시장을 뜻합니다.", "semanticHint": "황소(불)로 비유되는 상승장", "options": ["강세장", "약세장", "횡보장", "조정장"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "주가가 전반적으로 하락하는 비관적인 시장 상황을 뜻하는 용어는?", "answer": "약세장", "explanation": "약세장(베어마켓, Bear Market)은 주가가 지속적으로 내리는 비관적 시장으로, 보통 고점 대비 20% 이상 하락을 말합니다.", "semanticHint": "곰(베어)으로 비유되는 하락장", "options": ["약세장", "강세장", "활황장", "반등장"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "상장 요건을 충족하지 못한 종목이 증권시장에서 퇴출되는 것을 뜻하는 용어는?", "answer": "상장폐지", "explanation": "상장폐지는 상장 유지 요건을 못 지킨 기업이 거래소에서 퇴출되어 정규시장에서 거래가 중단되는 것입니다.", "semanticHint": "증시에서 쫓겨남", "options": ["상장폐지", "거래정지", "관리종목", "우회상장"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "상장폐지 우려가 있어 투자 주의를 위해 별도로 지정·관리하는 종목을 뜻하는 용어는?", "answer": "관리종목", "explanation": "관리종목은 재무·공시 등 요건 미달로 상장폐지 위험이 있어 거래소가 지정해 투자자에게 경고하는 종목입니다.", "semanticHint": "상장폐지 위험 경고 종목", "options": ["관리종목", "투자경고종목", "우선주", "테마주"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "배당 기준일이 지나 배당받을 권리가 사라지면서 이론적으로 주가가 조정되는 것은?", "answer": "배당락", "explanation": "배당락은 배당 기준일이 지나 배당받을 권리가 없어지면서 그만큼 주가가 조정되는 현상입니다.", "semanticHint": "배당 권리가 떨어져 나감", "options": ["배당락", "권리락", "상장폐지", "감자"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "증자 등에서 신주를 받을 권리가 사라지면서 이론적으로 주가가 조정되는 것은?", "answer": "권리락", "explanation": "권리락은 유상·무상증자 등에서 신주인수권이 없어지는 기준일 이후 그만큼 주가가 낮게 조정되는 현상입니다.", "semanticHint": "신주 받을 권리가 떨어져 나감", "options": ["권리락", "배당락", "액면분할", "감자"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "대량의 주식을 장 시작 전후에 기관 등 특정 상대와 미리 정한 가격으로 대량 거래하는 것은?", "answer": "블록딜", "explanation": "블록딜은 대주주·기관이 대량 지분을 시간외 대량매매로 넘겨 시장 충격을 줄이는 거래입니다.", "semanticHint": "대량 주식의 시간외 대량매매", "options": ["블록딜", "대차거래", "공모", "장중매매"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "회사가 임직원에게 미리 정한 가격으로 자사 주식을 살 수 있도록 부여하는 권리는?", "answer": "스톡옵션", "explanation": "스톡옵션(주식매수선택권)은 임직원이 정해진 가격에 회사 주식을 살 수 있는 권리로, 성과 보상 수단입니다.", "semanticHint": "임직원에게 주는 자사주 매수 권리", "options": ["스톡옵션", "우리사주", "자사주", "콜옵션"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "기업 실적이 시장 예상치를 크게 웃돌아 발표되는 것을 뜻하는 용어는?", "answer": "어닝서프라이즈", "explanation": "어닝서프라이즈는 실적이 시장 컨센서스를 크게 상회해 주가에 긍정적으로 작용하는 것을 말합니다.", "semanticHint": "예상보다 훨씬 좋은 실적", "options": ["어닝서프라이즈", "어닝쇼크", "컨센서스", "가이던스"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "기업 실적이 시장 예상치를 크게 밑돌아 실망을 주는 것을 뜻하는 용어는?", "answer": "어닝쇼크", "explanation": "어닝쇼크는 실적이 시장 기대에 크게 못 미쳐 주가에 부정적으로 작용하는 것을 말합니다.", "semanticHint": "예상보다 훨씬 나쁜 실적", "options": ["어닝쇼크", "어닝서프라이즈", "실적장세", "역실적"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "증권사·애널리스트들의 실적 예상치 평균을 뜻하는 용어는?", "answer": "컨센서스", "explanation": "컨센서스는 여러 애널리스트가 제시한 실적·목표주가 전망의 평균(시장 기대치)입니다.", "semanticHint": "시장 전망치의 평균", "options": ["컨센서스", "가이던스", "리포트", "밸류에이션"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "비상장 기업이 이미 상장된 기업과 합병 등을 통해 상장 효과를 얻는 것을 뜻하는 용어는?", "answer": "우회상장", "explanation": "우회상장(백도어 리스팅)은 비상장사가 상장사와의 합병 등으로 정식 IPO 없이 상장 지위를 얻는 것입니다.", "semanticHint": "정식 IPO 없이 뒷문으로 상장", "options": ["우회상장", "직상장", "재상장", "이전상장"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "상장·공모 후 일정 기간 대주주 등이 주식을 팔지 못하도록 묶어두는 것을 뜻하는 용어는?", "answer": "보호예수", "explanation": "보호예수(락업)는 상장 직후 대주주·기관 물량이 쏟아지는 것을 막기 위해 일정 기간 매도를 제한하는 제도입니다.", "semanticHint": "일정 기간 매도를 묶어둠(락업)", "options": ["보호예수", "블록딜", "배당락", "반대매매"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "시장현상", "question": "자산을 원하는 시점에 큰 손실 없이 현금으로 바꿀 수 있는 정도를 뜻하는 용어는?", "answer": "유동성", "explanation": "유동성은 자산을 신속하게 제 가격에 현금화할 수 있는 정도로, 거래량이 많을수록 유동성이 높습니다.", "semanticHint": "현금으로 바꾸기 쉬운 정도", "options": ["유동성", "변동성", "수익성", "안정성"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매전략", "question": "주가가 떨어졌을 때 추가로 매수해 평균 매입단가를 낮추는 행위를 뜻하는 용어는?", "answer": "물타기", "explanation": "물타기는 보유 종목이 하락했을 때 추가 매수로 평균단가를 낮추는 전략으로, 위험을 키울 수도 있습니다.", "semanticHint": "떨어질 때 더 사서 평단 낮추기", "options": ["물타기", "불타기", "손절", "익절"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매전략", "question": "손실을 확정하고 추가 하락을 막기 위해 보유 주식을 파는 것을 뜻하는 용어는?", "answer": "손절매", "explanation": "손절매는 예상과 달리 주가가 하락할 때 손실을 감수하고 매도해 더 큰 손실을 막는 행위입니다.", "semanticHint": "손실을 끊어내는 매도", "options": ["손절매", "익절매", "물타기", "분할매도"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "매매전략", "question": "하루 안에 주식을 사고팔아 단기 시세차익을 노리는 매매 방식은?", "answer": "데이트레이딩", "explanation": "데이트레이딩은 당일 매수·매도를 완결해 단기 변동으로 수익을 내려는 초단기 매매 방식입니다.", "semanticHint": "하루 안에 사고파는 매매", "options": ["데이트레이딩", "장기투자", "가치투자", "적립식투자"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "종목유형", "question": "실적·자산 대비 주가가 저평가되어 있다고 판단되는 종목을 뜻하는 용어는?", "answer": "가치주", "explanation": "가치주는 이익·자산 등 내재가치 대비 주가가 낮게 평가된 종목으로, 저평가 해소를 기대하고 투자합니다.", "semanticHint": "저평가된 종목", "options": ["가치주", "성장주", "테마주", "우선주"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "종목유형", "question": "매출·이익이 빠르게 성장할 것으로 기대되어 높은 밸류에이션을 받는 종목은?", "answer": "성장주", "explanation": "성장주는 높은 성장성을 기대받아 PER 등이 높게 형성되는 종목으로, 미래 이익 확대에 베팅합니다.", "semanticHint": "빠른 성장을 기대하는 종목", "options": ["성장주", "가치주", "배당주", "경기방어주"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "종목유형", "question": "특정 이슈나 테마(정치·정책·신기술 등)에 따라 주가가 함께 움직이는 종목군을 뜻하는 용어는?", "answer": "테마주", "explanation": "테마주는 특정 재료·이슈에 묶여 동반 등락하는 종목군으로, 변동성이 크고 실적과 무관하게 움직이기도 합니다.", "semanticHint": "이슈에 따라 함께 움직이는 종목", "options": ["테마주", "우량주", "가치주", "배당주"] },
    { "type": "MULTIPLE_CHOICE", "subCategory": "종목유형", "question": "재무가 튼튼하고 실적이 안정적인 대형 우량 기업의 주식을 뜻하는 용어는?", "answer": "블루칩", "explanation": "블루칩은 오랜 기간 안정적 실적과 높은 신뢰도를 가진 대형 우량주를 뜻합니다.", "semanticHint": "대형 우량주", "options": ["블루칩", "옐로칩", "동전주", "품절주"] },
    { "type": "SUBJECTIVE", "subCategory": "매매/호가", "question": "[주관식] 증권 계좌에 들어 있으면서 아직 투자하지 않고 남아 있는 현금 잔액을 세 글자로 무엇이라 하나요?", "answer": "예수금", "explanation": "예수금은 증권계좌에 예치된 현금 중 매수에 쓰이지 않은 잔액으로, 출금하거나 다음 매수에 사용할 수 있습니다.", "semanticHint": "미리 예(預) 자로 시작하는 계좌 현금" },
